---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
---
<Layout title="Blog" description='Todo el contenido sobre tecnologia'>
	<Nav />
	<h2>Todas las publicaciones</h2>
	<section>
		{
			posts.map(post => {
				const { slug, data } = post;
				const { title, description, cover } = data

				return (
					<article>
						<a href={`/blog/post/${slug}`}>
							<img src={`/blog/${cover}`} alt={title} />
							<h3>{title}</h3>
						</a>
					</article>
				)
			})
		}
	</section>
</Layout>
<style>
	h2 {
		margin: 20px;
	}
	section {
		display: grid;
		grid-template-columns: repeat(
		auto-fill,    
		minmax(250px, 1fr));
		gap: 20px;
		margin: 0 50px;
	}
	section img {
		width: 100%;
		max-height: 300px;
	}
	a {
		color: #000;
	}
	article {
		box-shadow: 4px 4px 10px rgba(0, 0, 0, 0.3);
		border-radius: 15px;
	}
	a {
		text-decoration: none;
		color: #000;
	}
	h3 {
		padding: 15px;
	}
</style>